# macOS 签名。证书需已安装在钥匙串。APPLE_SIGN=1 时使用钥匙串中的 Developer ID Application。
APPLE_SIGN=
APPLE_SIGNING_IDENTITY=

# macOS 公证，三选一：钥匙串 profile、App Store Connect API Key、Apple ID。
APPLE_KEYCHAIN_PROFILE=
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=

# Windows Authenticode。证书文件不要提交到仓库。
WINDOWS_CERTIFICATE_FILE=
WINDOWS_CERTIFICATE_PASSWORD=

# Azure Trusted Signing。设置后会覆盖上面的 pfx 签名参数。
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_METADATA_JSON=
AZURE_CODE_SIGNING_DLIB=
SIGNTOOL_PATH=

# 自动升级。静态目录按平台和架构存放，例如 https://cdn.example.com/agent-desktop-app/darwin/arm64
# 打包时写入安装包。公开 GitHub 仓库可改用 owner/name，并配合 publisher-github。
UPDATE_BASE_URL=
# 第二版及之后的 Windows 包设为 1，用于生成增量更新。首个版本保持为空。
SQUIRREL_REMOTE_RELEASES=
GITHUB_REPOSITORY=

# S3 发布。与 UPDATE_BASE_URL 指向同一套目录。
S3_BUCKET=
S3_REGION=
S3_FOLDER=

# 导出付费。未设置 PAYMENT_API_BASE 时走本地 Mock（可点「模拟支付成功」）。
# 设置后客户端将请求：
#   POST {PAYMENT_API_BASE}/pay/orders
#   GET  {PAYMENT_API_BASE}/pay/orders/:id
PAYMENT_API_BASE=
# 占位价格（分），定价规则确定前默认可为 1（¥0.01）
PAYMENT_AMOUNT_FEN=1
